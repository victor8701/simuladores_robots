<?xml version="1.0" ?>

<sdf version="1.6">

  <model name='my_diffdrive_robot'>
    <pose>0 2 0.325 0 -0 0</pose>

    <link name='chassis'>
      <pose>-0.151427 -0 0.175 0 -0 0</pose>
      <inertial>
        <mass>1.14395</mass>
        <inertia>
